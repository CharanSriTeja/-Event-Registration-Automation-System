generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id            Int            @id @default(autoincrement())
  name          String
  date          DateTime
  venue         String
  capacity      Int
  description   String?
  coverImageUrl String?
  createdAt     DateTime       @default(now())
  registrations Registration[]
  qrSendJobs    QrSendJob[]
}

model Registration {
  id                Int       @id @default(autoincrement())
  registrationId    String    @unique // format EVT-2026-0001
  name              String
  email             String
  phone             String
  collegeId         String?
  year              String?
  branch            String?
  eventId           Int
  event             Event     @relation(fields: [eventId], references: [id])
  registeredAt      DateTime  @default(now())
  entered           Boolean   @default(false)
  qrSent            Boolean   @default(false)
  qrCodeUrl         String?
  entryTimestamp    DateTime?
  paymentScreenshot String?
  paymentStatus     String    @default("pending")
  verifiedAt        DateTime?
  verifiedBy        String?
}

model QrSendJob {
  id                Int       @id @default(autoincrement())
  eventId           Int
  event             Event     @relation(fields: [eventId], references: [id])
  scheduledAt       DateTime  // when this job should start sending
  rateLimitPerMin   Int       @default(10)
  status            String    @default("pending")  // pending, processing, completed, failed
  totalToSend       Int?
  sentCount         Int       @default(0)
  failedCount       Int       @default(0)
  createdBy         String    // admin username
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  limitCount        Int?      // if set, send only to this many eligible registrations
}

model Volunteer {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // bcrypt hashed
  createdAt DateTime @default(now())
}

model EventCounter {
  eventId    Int  @id
  lastNumber Int  @default(0)
}
